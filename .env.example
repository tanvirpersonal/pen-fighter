# ---- Multiplayer server (server/server.js) ----
# Port the WebSocket server listens on.
PORT=8080
# Comma-separated list of allowed browser origins. Use * only for local development.
# Example: https://pen-fighter.example.com,http://localhost:5173
ALLOWED_ORIGINS=*
# Seconds a disconnected player has to reconnect before forfeiting the match.
RECONNECT_GRACE_SECONDS=20

# ---- Client (Vite) ----
# Copy these into .env.local. They are baked into the client bundle, so never put secrets here.
# WebSocket URL of the multiplayer server. Leave empty to use ws(s)://<current host>:8080.
VITE_WS_URL=
