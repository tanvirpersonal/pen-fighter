{
  "name": "pen-fighter",
  "version": "1.0.0",
  "description": "Pen Fighter (কলম খেলবি?) — physics-based pen-flicking game with 2D/3D views, AI, local and online multiplayer.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
